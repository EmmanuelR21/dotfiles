{
  "layer": "top",
  "position": "top",
  "height": 31,
  "width": "auto",
  "spacing": 6,
  "margin": "6 6 0",
  "modules-left": ["custom/arch", "hyprland/workspaces", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/hyprsunset",
    "group/audio",
    "bluetooth",
    "network",
    "battery",
    "custom/power",
  ],
  "custom/arch": {
    "format": "",
    "tooltip": false,
    "on-click": "$HOME/.config/waybar/scripts/system-popup.py",
  },
  "hyprland/workspaces": {
    "tooltip": false,
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 25,
    "tooltip": false,
    "on-click": "activate",
    "on-click-middle": "close",
    "sort-by-app-id": true,
    "squash-list": ["*"],
  },
  "battery": {
    "bat": "BAT0",
    "interval": 60,
    "tooltip": false,
    "on-click": "$HOME/.config/waybar/scripts/battery-popup.py",
    "format": "<span color='#f0f0f0'>{capacity}%</span> {icon}",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    },
  },
  "clock": {
    "interval": 60,
    "tooltip": false,
    "on-click": "$HOME/.config/waybar/scripts/calendar-popup.py",
    "format": "<span color='#d6dde9'></span> <span color='#ffffff'>{0:%A, %B %d}</span> <span color='#555555'>|</span> <span color='#d6dde9'></span> <span color='#ffffff' size='larger'>{0:%I:%M %p}</span> ",
    "locale": "en_US.UTF-8",
  },
  "group/audio": {
    "orientation": "inherit",
    "modules": ["wireplumber#sink", "wireplumber#source"],
  },
  "wireplumber#sink": {
    "tooltip": false,
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "$HOME/.config/waybar/scripts/audio-popup.py",
    "on-scroll-up": "",
    "on-scroll-down": "",
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "tooltip": false,
    "format": "󰍬",
    "format-muted": "󰍭",
    "on-click": "$HOME/.config/waybar/scripts/audio-popup.py",
    "on-scroll-up": "",
    "on-scroll-down": "",
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "$HOME/.config/waybar/scripts/power-popup.py",
  },
  "custom/hyprsunset": {
    "format": "󰖛",
    "on-click": "$HOME/.config/waybar/scripts/hyprsunset-popup.py",
    "tooltip": false,
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 <span color='#d6dde9'>{device_alias}</span> <span color='#555555'>|</span> <span color='#d6dde9'><span size='small' rise='1536'>󰁹</span> {device_battery_percentage}%</span>",
    "max-length": 30,
    "on-click": "$HOME/.config/waybar/scripts/bluetooth-popup.py",
    "tooltip": false,
  },
  "network": {
    "format": "󰖩",
    "format-ethernet": "󱘖",
    "format-disconnected": "󰖪",
    "format-disabled": "󰖪",
    "on-click": "$HOME/.config/waybar/scripts/network-popup.py",
    "tooltip": false,
  },
}
