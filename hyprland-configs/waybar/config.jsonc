// -*- mode: jsonc -*-
{
  "layer": "top", // Waybar at top layer
  "position": "top", //(top|bottom|left|right)
  "height": 30, // Waybar height (to be removed for auto height)
  "width": "auto", // Waybar width
  "spacing": 6, // Gaps between modules (4px)
  "margin": "6 6 0",
  "modules-left": ["hyprland/workspaces", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/hyprsunset",
    "group/audio",
    "network",
    "battery",
    "custom/power",
  ],
  // Modules configuration
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}",
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 25,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "sort-by-app-id": true,
    "squash-list": ["*"],
  },
  // Hidden automatically on machines without a battery
  "battery": {
    "bat": "BAT0",
    "interval": 60,
    "format": "{capacity}% {icon}",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    },
  },
  "clock": {
    "interval": 60,
    "tooltip": true,
    "format": "<span color='#777777'></span> <span color='#dedede'>{0:%A, %B %d}</span> <span color='#444444'>|</span> <span color='#777777'></span> <span color='#ffc547' size='larger'>{0:%I:%M %p}</span> ",
    "locale": "en_US.UTF-8",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ffcc66'><b>{}</b></span>",
      },
    },
  },
  "group/audio": {
    "orientation": "inherit",
    "modules": ["wireplumber#sink", "wireplumber#source"],
  },
  "wireplumber#sink": {
    "format": "<span alpha='90%'>{volume}%</span> {icon}",
    "format-muted": "<span alpha='70%'>{volume}%</span> 󰖁",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "<span alpha='90%'>{volume}%</span> 󰍬",
    "format-muted": "<span alpha='70%'>{volume}%</span> 󰍭",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "scroll-step": 5,
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
    "menu-actions": {
      "shutdown": "hyprshutdown -p 'systemctl poweroff'",
      "reboot": "hyprshutdown -p 'systemctl reboot'",
      "suspend": "systemctl suspend",
    },
  },
  "custom/hyprsunset": {
    "format": "󰖛",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/hyprsunset_menu.xml",
    "menu-actions": {
        "temp_5000": "pkill hyprsunset; hyprsunset -t 5000 &",
        "temp_4000": "pkill hyprsunset; hyprsunset -t 4000 &",
        "temp_3000": "pkill hyprsunset; hyprsunset -t 3000 &",
        "turn_off": "pkill hyprsunset"
    },
    "tooltip": true,
    "tooltip-format": "Hyprsunset Menu"
  },
  "network": {
	"interface": "enp7s0",
	"interval": 3,
	"format": "{ifname}",
	"format-wifi": "󰖩",
	"format-ethernet": "󱘖",
	"format-disconnected": "", //An empty format will hide the module.
	// Click to expand into live speeds, click again to collapse
	"format-alt": "󱘖  <span alpha='80%'>↓</span> {bandwidthDownBytes}  <span alpha='80%'>↑</span> {bandwidthUpBytes}",
	"max-length": 50,
	"tooltip": true,
	"tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}",
	"tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}"
  }
}
